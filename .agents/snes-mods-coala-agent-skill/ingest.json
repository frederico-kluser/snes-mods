{
  "_doc": "Fontes do material do projeto para `coala.py sync`. rules: mode markdown|text|whole|pdf · type episodic|semantic|procedural · origin owner|agent|untrusted|system · tags aceitam {stem} {name} {dir} {rule}; a primeira regra que apanha um ficheiro ganha. code: o catálogo de código (símbolos por ficheiro) é automático — `include`/`exclude` são globs, `enabled: false` desliga. Ver references/instalar.md da coala-agent-skill.",
  "version": 2,
  "key_prefix": "proj",
  "path_prefix": "",
  "exclude": [],
  "rules": [
    {
      "name": "readme",
      "include": [
        "README.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,readme"
    },
    {
      "name": "claude-md",
      "include": [
        "CLAUDE.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,regras"
    },
    {
      "name": "docs",
      "include": [
        "docs/*.md",
        "CONTRIBUTING.md",
        "THIRD_PARTY_NOTICES.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,{stem}"
    },
    {
      "name": "jogos",
      "include": [
        "games/*/notes.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "jogo,{dir}"
    },
    {
      "name": "mods",
      "include": [
        "mods/*/README.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "mod,{dir}"
    },
    {
      "name": "ciclos",
      "include": [
        "cycles/*/cycle-*/report.md"
      ],
      "mode": "markdown",
      "type": "episodic",
      "origin": "system",
      "tags": "ciclo"
    }
  ],
  "code": {
    "enabled": true,
    "include": [],
    "exclude": []
  },
  "graph": {
    "entities": [],
    "edges": []
  }
}
